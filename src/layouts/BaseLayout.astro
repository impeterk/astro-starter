---
import "@/styles/starwind.css";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import ThemeSwitcher from "@/lib/scripts/theme-switcher.astro";
import type { Theme } from "@/lib/types";
import AppSidebar from "@/components/app-sidebar.astro";
const { title, description } = Astro.props;
const theme = (Astro.cookies.get("__theme")?.value || "system") as Theme;
---

<html lang="en" class={theme}>
  <head>
    <BaseHead title={title} description={description} />
    {theme === "system" && <ThemeSwitcher />}
  </head>

  <body class="container">
    <AppSidebar>
      <div class="sm:rounded-xl sm:border sm:border-sidebar-border my-2 w-full grid grid-rows-[1fr_auto]">
        <main>
          <slot />
        </main>
        <Footer />
      </div>
    </AppSidebar>
  </body>
</html>
<style>
  html,
  body {
    height: 100%;
  }
</style>
