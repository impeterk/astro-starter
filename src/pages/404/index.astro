---
import CatImage from "./_cat.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import { Button } from "@/components/starwind/button";

interface Props extends HTMLAttributes<"section"> {
  /** Short error code shown above the heading. */
  code?: string;
  /** Main error message. */
  heading?: string;
  /** Optional guidance for the visitor. */
  description?: string;
  /** Primary recovery action label. */
  primaryActionText?: string;
  /** Primary recovery action destination. */
  primaryActionHref?: string;
  /** Optional secondary recovery action label. */
  secondaryActionText?: string;
  /** Optional secondary recovery action destination. */
  secondaryActionHref?: string;
}

const error4041Styles = tv({
  base: [
    "container relative isolate w-full items-center overflow-hidden px-4 py-24 text-foreground",
    "xl:min-h-[76svh]",
  ],
});

const {
  code = "404",
  heading = "Page was not found",
  description,
  primaryActionText = "Return home",
  primaryActionHref = "/",
  secondaryActionText,
  secondaryActionHref,
  class: className,
  ...rest
} = Astro.props;

const hasPrimaryAction = Boolean(primaryActionText && primaryActionHref);
const hasSecondaryAction = Boolean(secondaryActionText && secondaryActionHref);
const hasActions = hasPrimaryAction || hasSecondaryAction;
---

<BaseLayout title="Not found">
  <section class={error4041Styles({ class: className })} {...rest}>
    <CatImage />

    <div class="mx-auto w-full max-w-2xl text-center">
      {code && (
        <p class="text-primary-accent text-sm font-semibold tracking-[0.18em]">
          {code}
        </p>
      )}

      <h1 class="font-heading mt-5 text-4xl font-semibold tracking-tight text-balance @xl:text-5xl @3xl:text-6xl">
        {heading}
      </h1>

      {description && (
        <p class="text-muted-foreground mx-auto mt-5 max-w-xl text-base leading-7 text-pretty @xl:text-lg">
          {description}
        </p>
      )}

      {hasActions && (
        <div class="mt-9 flex flex-col justify-center gap-3 @xl:flex-row">
          {hasPrimaryAction && (
            <Button
              href={primaryActionHref}
              size="lg"
              class="w-full @xl:w-auto"
            >
              {primaryActionText}
            </Button>
          )}

          {hasSecondaryAction && (
            <Button
              href={secondaryActionHref}
              variant="outline"
              size="lg"
              class="w-full @xl:w-auto"
            >
              {secondaryActionText}
            </Button>
          )}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
