---
import { Button } from "./starwind/button";
import { ButtonGroup } from "./starwind/button-group";
import { ThemeSwitcher } from "./react/theme-switch";
import { Logo } from "./favicon";
const { theme } = Astro.props;

const { pathname } = Astro.url;

const navLinks = [
  // {
  //   href: "/",
  //   label: "Home",
  // },
  {
    href: "/blog",
    label: "Blog",
  },
  {
    href: "/work",
    label: "Work",
  },
  { href: "/about", label: "About" },
  { href: "/now", label: "Now" },
];
---

<header class="border-b container sticky top-0 bg-background z-10">
  <nav class="grid grid-cols-3 items-center py-4">
    <div class="relative overflow-hidden">
      <Button
        variant={"ghost"}
        class:list={["text-foreground", { "translate-y-16": pathname === "/" }]}
        href="/"
      >
        <div class="-ml-2">
          <Logo size="size-8" />
        </div>
        peterk.dev
      </Button>
    </div>
    <ButtonGroup
      as="ul"
      class:list={[
        "bg-secondary/50 justify-self-center rounded-lg overflow-hidden",
      ]}
    >
      {navLinks.map((link) => {
        const active = link.href === pathname;
        return (
          <Button
            variant="link"
            class:list={[
              "text-foreground hover:no-underline border-b-2 border-b-transparent  hover:border-primary rounded-b-none relative",
              active && "border-b-2 border-primary",
            ]}
            href={link.href}
          >
            {link.label}
            {active && (
              <div
                transition:name={`active-indicator`}
                class={"bg-primary absolute -bottom-0.5 left-0 h-0.5 inset-x-0"}
              />
            )}
          </Button>
        );
      })}
    </ButtonGroup>
    <div class="flex gap-2 items-center ml-auto">
      <ThemeSwitcher client:load transition:persist active={theme} />
    </div>
  </nav>
</header>
