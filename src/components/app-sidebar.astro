---
import Sidebar from "./starwind/sidebar";
import { Logo } from "./favicon";
import {
  IconArticle,
  IconBrandGithub,
  IconBroadcast,
  IconCode,
  IconHome,
  IconMail,
  IconUser,
} from "@tabler/icons-react";
import { fade } from "astro:transitions";

const { pathname } = Astro.url;

const paths = [
  [
    {
      href: "/",
      label: "Home",
      icon: IconHome,
    },
    {
      href: "/posts",
      label: "Articles",
      icon: IconArticle,
    },
    {
      href: "/projects",
      label: "Work",
      icon: IconCode,
    },
  ],
  [
    { href: "/about", label: "About me", icon: IconUser },
    { href: "/now", label: "Now", icon: IconBroadcast },
    { href: "/contact", label: "Get in touch", icon: IconMail },
  ],
];
---

<Sidebar.Root>
  <Sidebar.Sidebar variant="inset">
    <Sidebar.Header>
      <Sidebar.Menu>
        <Sidebar.MenuItem>
          <Sidebar.MenuButton size="lg" href="/">
            <div class="size-10 rounded-xl outline">
              <Logo />
            </div>
            <div class="grid">
              <span class="font-semibold text-sm">Peterk.dev</span>
              <span class="text-sidebar-foreground/70 text-xs">
                Full-stack developer
              </span>
            </div>
          </Sidebar.MenuButton>
        </Sidebar.MenuItem>
      </Sidebar.Menu>
    </Sidebar.Header>

    <Sidebar.Content>
      {paths.map((menu, idx) => (
        <Sidebar.Group>
          {idx == 0 && <Sidebar.GroupLabel>Navigation</Sidebar.GroupLabel>}
          <Sidebar.GroupContent>
            <Sidebar.Menu>
              {menu.map((Item) => {
                const isActive = pathname === Item.href;
                return (
                  <>
                    <Sidebar.MenuItem class="relative ">
                      <Sidebar.MenuButton
                        class="relative z-10"
                        href={Item.href}
                        isActive={isActive}
                      >
                        <Item.icon /> {Item.label}
                      </Sidebar.MenuButton>
                    {isActive && (
                      <div
                        transition:name={"active-nav-btn"}
                        class="absolute top-0 left-0 rounded-lg bg-sidebar-accent/50 w-full h-full z-0"
                      />
                    )}
                    </Sidebar.MenuItem>
                  </>
                );
              })}
            </Sidebar.Menu>
          </Sidebar.GroupContent>
        </Sidebar.Group>
      ))}
    </Sidebar.Content>

    <Sidebar.Footer>
      <Sidebar.Group>
        <Sidebar.GroupLabel>Socials</Sidebar.GroupLabel>
        <Sidebar.Menu class="grid grid-cols-3">
          <Sidebar.MenuItem>
            <Sidebar.MenuButton class="justify-center">
              <IconBrandGithub />
            </Sidebar.MenuButton>
          </Sidebar.MenuItem>
        </Sidebar.Menu>
      </Sidebar.Group>
    </Sidebar.Footer>
  </Sidebar.Sidebar>
  <slot />
</Sidebar.Root>
