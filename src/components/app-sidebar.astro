---
import Sidebar from "./starwind/sidebar";
import { Logo } from "./favicon";
---

<Sidebar.Root>
  <Sidebar.Sidebar variant="inset">
    <Sidebar.Header>
      <Sidebar.Menu>
        <Sidebar.MenuItem>
          <Sidebar.MenuButton size="lg" href="/">
            <div class="size-10 rounded-xl outline">
              <Logo />
            </div>
            <div class="grid">
              <span class="font-semibold text-sm">Peterk.dev</span>
              <span class="text-sidebar-foreground/70 text-xs">
                Full-stack developer
              </span>
            </div>
          </Sidebar.MenuButton>
        </Sidebar.MenuItem>
      </Sidebar.Menu>
    </Sidebar.Header>

    <Sidebar.Content>
      <Sidebar.Group>
        <Sidebar.GroupLabel>Navigation</Sidebar.GroupLabel>
        <Sidebar.GroupContent>
          <Sidebar.Menu></Sidebar.Menu>
        </Sidebar.GroupContent>
      </Sidebar.Group>
    </Sidebar.Content>
  </Sidebar.Sidebar>
  <slot />
</Sidebar.Root>
