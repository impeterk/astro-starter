---
import Sidebar from "./starwind/sidebar";
import { Logo } from "./favicon";
import {
  IconArticle,
  IconBrandGithub,
  IconBroadcast,
  IconCode,
  IconHome,
  IconMail,
  IconUser,
} from "@tabler/icons-react";
const { theme } = Astro.props;
import { ThemeSwitcher } from "./react/theme-switch";

const { pathname } = Astro.url;

const paths = [
  [
    {
      href: "/",
      label: "Home",
      icon: IconHome,
    },
    {
      href: "/posts",
      label: "Articles",
      icon: IconArticle,
    },
    {
      href: "/projects",
      label: "Work",
      icon: IconCode,
    },
  ],
  [
    { href: "/about", label: "About me", icon: IconUser },
    { href: "/now", label: "Now", icon: IconBroadcast },
    { href: "/contact", label: "Get in touch", icon: IconMail },
  ],
];
---

<Sidebar.Root>
  <Sidebar.Sidebar variant="inset">
    <Sidebar.Header>
      <Sidebar.Menu>
        <Sidebar.MenuItem>
          <Sidebar.MenuButton size="lg" href="/">
            <div class="size-10 rounded-xl outline">
              <Logo />
            </div>
            <div class="grid">
              <span class="font-semibold text-sm">Peterk.dev</span>
              <span class="text-sidebar-foreground/70 text-xs">
                Full-stack developer
              </span>
            </div>
          </Sidebar.MenuButton>
        </Sidebar.MenuItem>
      </Sidebar.Menu>
    </Sidebar.Header>

    <Sidebar.Content>
      {paths.map((menu) => (
        <Sidebar.Group>
          <Sidebar.GroupContent>
            <Sidebar.Menu>
              {menu.map((Item) => {
                const isActive = pathname === Item.href;
                return (
                  <>
                    <Sidebar.MenuItem class="relative">
                      <Sidebar.MenuButton
                        class="relative overflow-clip"
                        href={Item.href}
                      >
                        <Item.icon /> {Item.label}
                      </Sidebar.MenuButton>
                      {isActive && (
                        <div
                          transition:name={"active-nav-btn"}
                          class="absolute bottom-0 bg-primary inset-x-0 h-px"
                        />
                      )}
                    </Sidebar.MenuItem>
                  </>
                );
              })}
            </Sidebar.Menu>
          </Sidebar.GroupContent>
        </Sidebar.Group>
      ))}
    </Sidebar.Content>

    <Sidebar.Footer>
      <Sidebar.Group>
        <Sidebar.GroupLabel>Socials</Sidebar.GroupLabel>
        <Sidebar.Menu class="grid grid-cols-3">
          <Sidebar.MenuItem>
            <Sidebar.MenuButton class="justify-center">
              <IconBrandGithub />
            </Sidebar.MenuButton>
          </Sidebar.MenuItem>
        </Sidebar.Menu>
      </Sidebar.Group>
      <Sidebar.Group>
        <Sidebar.GroupLabel>Theme</Sidebar.GroupLabel>
        <Sidebar.Menu class="w-fit mx-auto">
          <ThemeSwitcher client:load transition:persist active={theme} />
        </Sidebar.Menu>
      </Sidebar.Group>
    </Sidebar.Footer>
  </Sidebar.Sidebar>
  <slot />
</Sidebar.Root>
