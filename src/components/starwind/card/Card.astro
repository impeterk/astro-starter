---
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "tailwind-variants";

import { card } from "./variants";

type Props = HTMLAttributes<any> & VariantProps<typeof card>;

const {
  size = "md",
  variant = "default",
  as = "div",
  class: className,
  ...rest
} = Astro.props;

const Component = as;
---

<Component
  data-sw-card
  class={card({ variant, size, class: className })}
  {...rest}
  data-size={size}
  data-slot="card"
>
  <slot />
</Component>
